// Field Day room rules. Merge this match block inside the existing
// match /databases/{database}/documents block. Preserve the Stronghold rules.
// A six-digit code is an invitation locator. Authenticated UIDs own the seats.
match /fdfdRooms/{code} {
  function signedIn() {
    return request.auth != null;
  }

  function member(room) {
    return signedIn() &&
      (room.hostUid == request.auth.uid || room.guestUid == request.auth.uid);
  }

  function validNewRoom() {
    let room = request.resource.data;
    return signedIn() &&
      code.matches('^[0-9]{6}$') &&
      room.keys().hasAll(['session', 'hostUid', 'guestUid', 'mode', 'phase', 'createdAt', 'expiresAt']) &&
      room.keys().hasOnly(['session', 'hostUid', 'guestUid', 'mode', 'phase', 'createdAt', 'expiresAt']) &&
      room.session is string && room.session.matches('^[a-f0-9]{32}$') &&
      room.hostUid == request.auth.uid && room.guestUid == null &&
      room.mode in ['coop', 'duel', 'ffa'] && room.phase == 'waiting' &&
      room.createdAt == request.time && room.expiresAt is timestamp &&
      room.expiresAt > request.time &&
      room.expiresAt <= request.time + duration.value(30, 'm');
  }

  function canJoin() {
    return signedIn() && resource.data.phase == 'waiting' &&
      resource.data.expiresAt > request.time && resource.data.guestUid == null &&
      resource.data.hostUid != request.auth.uid &&
      request.resource.data.guestUid == request.auth.uid &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestUid']);
  }

  function hostTransition() {
    return signedIn() && resource.data.hostUid == request.auth.uid &&
      resource.data.expiresAt > request.time &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase']) &&
      ((resource.data.phase == 'waiting' &&
        resource.data.guestUid is string && request.resource.data.phase == 'playing') ||
       (resource.data.phase in ['waiting', 'playing'] && request.resource.data.phase == 'closed'));
  }

  allow get: if member(resource.data) && resource.data.expiresAt > request.time;
  allow list, delete: if false;
  allow create: if validNewRoom();
  allow update: if canJoin() || hostTransition() ||
    (resource.data.expiresAt <= request.time && validNewRoom() &&
      request.resource.data.session != resource.data.session);

  match /signals/{session}/seats/{seat} {
    function parentRoom() {
      return get(/databases/$(database)/documents/fdfdRooms/$(code)).data;
    }

    function active(room) {
      return member(room) && room.session == session &&
        room.expiresAt > request.time && room.phase in ['waiting', 'playing'];
    }

    function canSignal() {
      let room = parentRoom();
      let payload = request.resource.data;
      return active(room) &&
        ((seat == 'host' && room.hostUid == request.auth.uid) ||
         (seat == 'guest' && room.guestUid == request.auth.uid)) &&
        payload.keys().hasAll(['description', 'updatedAt']) &&
        payload.keys().hasOnly(['description', 'updatedAt']) &&
        payload.description is string && payload.description.size() > 0 &&
        payload.description.size() <= 32768 && payload.updatedAt == request.time;
    }

    allow get: if seat in ['host', 'guest'] && active(parentRoom());
    allow create, update: if canSignal();
    allow list, delete: if false;
  }
}
